            <div class="card">

                <i class="fas fa-image"></i>

                <h3>Large Format</h3>

                <p>

                    Banners, Flex,
                    Stickers and Signages.

                </p>

            </div>

            <div class="card">

                <i class="fas fa-shirt"></i>

                <h3>DTF Printing</h3>

                <p>

                    Premium Direct-to-Film
                    Printing Solutions.

                </p>

            </div>

            <div class="card">

                <i class="fas fa-camera"></i>

                <h3>Photography</h3>

                <p>

                    Indoor and Outdoor
                    Photography Services.

                </p>

            </div>

            <div class="card">

                <i class="fas fa-gift"></i>

                <h3>Souvenirs</h3>

                <p>

                    Customized gifts,
                    mugs, pillows and more.

                </p>

