<body>

    <!-- HERO SECTION -->

    <section class="hero">

        <div class="overlay"></div>

        <div class="container">

            <img src="logo.png" class="logo" alt="Dynamo Logo">

            <h1>
                DYNAMO
                <span>CONCEPTZ</span>
            </h1>

            <p class="motto"></p>

            <p class="description">

